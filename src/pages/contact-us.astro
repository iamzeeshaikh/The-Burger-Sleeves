---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import InquiryForm from '../components/InquiryForm.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Icon from '../components/Icon.astro';
import { PAGE_META } from '../data/pages.ts';
import { SITE } from '../data/site.ts';
import { DEFAULT_OG } from '../lib/og.ts';
import { graph, organizationNode, websiteNode, breadcrumbNode } from '../lib/schema.ts';

const meta = PAGE_META['/contact-us/'];
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Contact Us' }];
const schema = graph([organizationNode(), websiteNode(), breadcrumbNode(crumbs)]);

const mapSrc = `https://maps.google.com/maps?q=${encodeURIComponent(SITE.address)}&t=m&z=10&output=embed&iwloc=near`;
---

<BaseLayout title={meta.title} description={meta.description} ogImage={DEFAULT_OG} schema={schema}>
  <PageHeader title="Contact Us" crumbs={crumbs} />

  <section class="section section--tight section--flush">
    <div class="container container--wide contact-cards">
      <div class="contact-card">
        <div class="contact-card__icon"><Icon name="phone" size={24} /></div>
        <h2 class="contact-card__title">Call Us</h2>
        <p><a href={SITE.phoneHref}>{SITE.phone}</a></p>
      </div>
      <div class="contact-card">
        <div class="contact-card__icon"><Icon name="envelope" size={24} /></div>
        <h2 class="contact-card__title">Email</h2>
        <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      </div>
      <div class="contact-card">
        <div class="contact-card__icon"><Icon name="map-marker" size={24} /></div>
        <h2 class="contact-card__title">Location</h2>
        <address>303 W 137th Street, #5A New York,<br />NY 10030 United States</address>
      </div>
    </div>
  </section>

  <section class="section section--tight section--flush">
    <div class="container container--wide contact-split">
      <div class="contact-map">
        <iframe
          src={mapSrc}
          title={`Map showing ${SITE.address}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
      <div class="contact-form">
        <h2 class="section-title">Let's Connect</h2>
        <p class="section-subtitle">
          Have a question or need assistance? Fill out the form below and our team will get back to
          you shortly.
        </p>
        <InquiryForm variant="contact" id="contact" />
      </div>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>

<style>
  .contact-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .contact-card {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    padding: 26px 22px;
    text-align: center;
  }
  .contact-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: var(--red);
    color: var(--white);
    margin-bottom: 14px;
  }
  .contact-card__title {
    font-size: 20px;
    font-weight: 600;
    margin: 0 0 8px;
  }
  .contact-card a:hover {
    color: var(--red);
  }
  .contact-card address {
    font-style: normal;
    line-height: 1.6;
  }
  @media (max-width: 767px) {
    .contact-cards {
      grid-template-columns: 1fr;
    }
  }

  .contact-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: start;
  }
  .contact-map {
    aspect-ratio: 4 / 3;
    border: 1px solid var(--border);
    border-radius: 4px;
    overflow: hidden;
  }
  .contact-map iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .contact-form .section-title {
    margin-bottom: 10px;
  }
  @media (max-width: 900px) {
    .contact-split {
      grid-template-columns: 1fr;
    }
    .contact-map {
      aspect-ratio: 16 / 10;
    }
  }
</style>
