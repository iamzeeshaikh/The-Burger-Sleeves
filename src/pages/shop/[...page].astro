---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShopArchive from '../../components/ShopArchive.astro';
import { productsAlphabetical, paginate, PER_PAGE } from '../../lib/catalog.ts';
import { PAGE_META, paginatedTitle } from '../../data/pages.ts';
import { ogUrl, DEFAULT_OG } from '../../lib/og.ts';
import {
  graph,
  organizationNode,
  websiteNode,
  breadcrumbNode,
  itemListNode,
} from '../../lib/schema.ts';

/**
 * /shop/ and its WordPress-style pagination (/shop/page/2/, /shop/page/3/).
 * Both extra pages return 200 and self-canonicalise on the live site, so they
 * are reproduced rather than redirected — and, like Yoast did, kept out of the
 * sitemap.
 */
export const getStaticPaths = (() => {
  const pages = paginate(productsAlphabetical);
  return pages.map((items, i) => ({
    params: { page: i === 0 ? undefined : `page/${i + 1}` },
    props: { items, current: i + 1, total: pages.length },
  }));
}) satisfies GetStaticPaths;

const { items, current, total } = Astro.props;

const meta = PAGE_META['/shop/'];
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Shop' }];

const from = (current - 1) * PER_PAGE + 1;
const to = from + items.length - 1;
const resultsLabel = `Showing ${from}–${to} of ${productsAlphabetical.length} results`;

const schema = graph([
  organizationNode(),
  websiteNode(),
  breadcrumbNode(crumbs),
  itemListNode(items.map((p) => ({ name: p.name, url: p.url }))),
]);
---

<BaseLayout
  title={paginatedTitle(meta.title, current, total)}
  description={meta.description}
  ogImage={ogUrl(items[0]?.images[0]?.file) ?? DEFAULT_OG}
  schema={schema}
>
  <ShopArchive
    h1="Shop"
    crumbs={crumbs}
    products={items}
    resultsLabel={resultsLabel}
    pagination={{ current, total, hrefFor: (n) => (n === 1 ? '/shop/' : `/shop/page/${n}/`) }}
  />
</BaseLayout>
