---
import { getImage as astroImage } from 'astro:assets';
import { getImage, PLACEHOLDER } from '../lib/images.ts';
import type { ProductImage } from '../lib/catalog.ts';

/**
 * Main image plus thumbnail strip, matching the WooCommerce gallery layout.
 * Clicking a thumbnail swaps the main image in place (src + srcset), and a
 * small script pre-warms every gallery image so the swap is instant.
 */
export interface Props {
  images: ProductImage[];
  productName: string;
  id?: string;
}
const { images, productName, id = 'gallery' } = Astro.props;

const shots = images.length
  ? images
  : [{ file: PLACEHOLDER, alt: `${productName} — product photography coming soon` }];

const sizes = '(max-width: 900px) 92vw, 400px';
const resolved = (
  await Promise.all(
    shots.map(async (s) => {
      const meta = getImage(s.file);
      if (!meta) return null;
      const main = await astroImage({ src: meta, widths: [400, 800], sizes });
      const thumb = await astroImage({ src: meta, width: 140 });
      return { alt: s.alt, main, thumb };
    }),
  )
).filter((s): s is NonNullable<typeof s> => s !== null);

const first = resolved[0];
---

{
  first && (
    <div class="gallery" data-gallery>
      <div class="gallery__stage">
        <img
          class="gallery__main"
          data-main-img
          src={first.main.src}
          srcset={first.main.srcSet.attribute}
          sizes={sizes}
          alt={first.alt || productName}
          width={first.main.attributes.width}
          height={first.main.attributes.height}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      {resolved.length > 1 && (
        <ul class="gallery__thumbs">
          {resolved.map((s, i) => (
            <li>
              <button
                type="button"
                class:list={['thumb-btn', { active: i === 0 }]}
                data-src={s.main.src}
                data-srcset={s.main.srcSet.attribute}
                data-alt={s.alt || `${productName} image ${i + 1}`}
                aria-label={`View image ${i + 1} of ${resolved.length}: ${s.alt || productName}`}
              >
                <img
                  src={s.thumb.src}
                  alt={s.alt || `${productName} image ${i + 1}`}
                  width={s.thumb.attributes.width}
                  height={s.thumb.attributes.height}
                  loading="lazy"
                  decoding="async"
                />
              </button>
            </li>
          ))}
        </ul>
      )}
    </div>
  )
}

<script>
  function initGallery(gallery: HTMLElement) {
    const mainImg = gallery.querySelector<HTMLImageElement>('[data-main-img]');
    const thumbs = Array.from(gallery.querySelectorAll<HTMLButtonElement>('.thumb-btn'));
    if (!mainImg || thumbs.length === 0) return;

    const warmed = new Set<string>();
    const warm = (src: string | undefined, srcset?: string) => {
      if (!src || warmed.has(src)) return;
      warmed.add(src);
      const img = new Image();
      img.fetchPriority = 'low';
      if (srcset) {
        img.sizes = mainImg.sizes || '';
        img.srcset = srcset;
      }
      img.src = src;
    };
    const warmAll = () => {
      for (const btn of thumbs) warm(btn.dataset.src, btn.dataset.srcset);
    };

    // Pre-warm every gallery image when the browser is idle so swaps are instant.
    if ('requestIdleCallback' in window) {
      requestIdleCallback(warmAll, { timeout: 3000 });
    } else {
      window.addEventListener('load', () => setTimeout(warmAll, 500), { once: true });
    }

    for (const btn of thumbs) {
      // Warm eagerly on intent, in case idle warming hasn't run yet.
      btn.addEventListener('pointerenter', () => warm(btn.dataset.src, btn.dataset.srcset), {
        passive: true,
      });
      btn.addEventListener('touchstart', () => warm(btn.dataset.src, btn.dataset.srcset), {
        passive: true,
      });
      btn.addEventListener('click', () => {
        if (!btn.dataset.src) return;
        for (const other of thumbs) other.classList.remove('active');
        btn.classList.add('active');
        // srcset must be set before src so the browser picks the right candidate.
        mainImg.srcset = btn.dataset.srcset || '';
        mainImg.src = btn.dataset.src;
        if (btn.dataset.alt) mainImg.alt = btn.dataset.alt;
      });
    }
  }

  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach(initGallery);
</script>

<style>
  .gallery__stage {
    display: grid;
  }
  .gallery__main {
    width: 100%;
    height: auto;
    border-radius: 2px;
  }

  .gallery__thumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
  }
  .thumb-btn {
    display: block;
    width: 70px;
    border: 1px solid transparent;
    background: none;
    padding: 2px;
    cursor: pointer;
    border-radius: 3px;
  }
  .thumb-btn:hover {
    border-color: var(--border);
  }
  .thumb-btn:focus-visible {
    outline: var(--focus);
    outline-offset: 2px;
  }
  .thumb-btn.active {
    border-color: var(--red);
    background: #f3f3f3;
  }
  .thumb-btn img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 2px;
  }
</style>
