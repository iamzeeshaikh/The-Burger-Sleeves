---
import Icon from './Icon.astro';
import { SITE, SOCIAL_ICONS } from '../data/site.ts';
---

<div class="announce">
  <div class="container container--wide announce__inner">
    <ul class="announce__contact">
      <li>
        <a href={SITE.phoneHref}>
          <Icon name="phone" size={18} />
          <span>{SITE.phone}</span>
        </a>
      </li>
      <li>
        <a href={`mailto:${SITE.email}`}>
          <Icon name="envelope" size={18} />
          <span>{SITE.email}</span>
        </a>
      </li>
    </ul>
    <ul class="announce__social">
      {
        SOCIAL_ICONS.map((n) => (
          <li>
            <span class="announce__social-icon">
              <Icon name={n} size={15} />
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .announce {
    background: var(--red);
    color: var(--white);
  }
  .announce__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    min-height: 40px;
    padding-block: 6px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .announce__contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
    font-size: 15px;
  }
  .announce__contact a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--white);
  }
  .announce__contact a:hover {
    color: var(--white);
    text-decoration: underline;
  }
  .announce__contact :global(svg) {
    flex: none;
  }
  .announce__social {
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .announce__social-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--white);
    color: var(--red);
  }
  @media (max-width: 767px) {
    .announce__inner {
      flex-direction: column;
      align-items: stretch;
      gap: 8px;
      padding-block: 10px;
    }
    .announce__contact {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
      font-size: 14px;
    }
    /* The live bar keeps the social row right-aligned under the contacts. */
    .announce__social {
      justify-content: flex-end;
    }
  }
</style>
