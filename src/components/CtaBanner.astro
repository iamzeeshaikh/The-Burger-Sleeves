---
import { getImage } from '../lib/images.ts';
import { SITE } from '../data/site.ts';
import { getImage as astroImage } from 'astro:assets';

/**
 * The "Footer CTA" Elementor section (library post 310) that closes the
 * homepage, product, category, about and contact pages.
 */
const bg = getImage('logo-printed-food-sleeves.jpg')!;
const bgOptimised = await astroImage({ src: bg, format: 'webp', width: 1600, quality: 70 });
---

<section class="cta" style={`--cta-bg:url('${bgOptimised.src}')`}>
  <div class="container cta__inner">
    <h2 class="cta__title">Ready to Elevate Your Burger Packaging?</h2>
    <p class="cta__text">
      Get started with custom burger sleeves that showcase your brand and delight your customers.
      Contact us today for a free quote and design consultation.
    </p>
    <div class="cta__actions">
      <a class="btn btn--primary" href="/get-free-quote/">Request Free Quote</a>
      <a class="btn btn--white" href={SITE.phoneHref}>Call Us Now</a>
      <a class="btn btn--outline-white" href={`mailto:${SITE.email}`}>Email</a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    isolation: isolate;
    background-image: var(--cta-bg);
    background-position: center center;
    background-repeat: no-repeat;
    background-size: cover;
    padding: 60px 10px;
    text-align: center;
    color: var(--white);
  }
  .cta::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--black);
    opacity: 0.7;
  }
  .cta__title {
    font-size: 40px;
    font-weight: 600;
    line-height: 1.2;
    margin: 0 0 14px;
  }
  .cta__text {
    max-width: 640px;
    margin: 0 auto 24px;
    font-size: var(--text-size);
    line-height: 1.6;
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  @media (max-width: 1024px) {
    .cta__title {
      font-size: 32px;
    }
  }
  @media (max-width: 767px) {
    .cta {
      padding: 45px 10px;
    }
    .cta__title {
      font-size: 28px;
    }
  }
</style>
