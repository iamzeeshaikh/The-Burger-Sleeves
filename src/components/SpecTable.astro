---
export interface Props {
  headers: string[];
  rows: string[][];
  caption?: string;
}
const { headers, rows, caption } = Astro.props;
---

<div class="table-scroll" tabindex="0" role="region" aria-label={caption ?? 'Specifications'}>
  <table>
    {caption && <caption class="visually-hidden">{caption}</caption>}
    <thead>
      <tr>{headers.map((h) => <th scope="col">{h}</th>)}</tr>
    </thead>
    <tbody>
      {
        rows.map((r) => (
          <tr>
            {r.map((cell, i) =>
              i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>,
            )}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
