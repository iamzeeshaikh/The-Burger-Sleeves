---
import Breadcrumbs from './Breadcrumbs.astro';

/**
 * The red page-title band the live site puts at the top of every product
 * category, About, Contact, Get Free Quote and Thank You page: centred white
 * breadcrumb over a centred white H1, 50px padding, 1300px content width.
 */
export interface Props {
  title: string;
  crumbs: { name: string; url?: string }[];
}
const { title, crumbs } = Astro.props;
---

<section class="page-band">
  <div class="container container--wide page-band__inner">
    <Breadcrumbs crumbs={crumbs} class="page-band__crumbs" />
    <h1 class="page-band__title">{title}</h1>
  </div>
</section>

<style>
  .page-band {
    background: var(--red);
    padding: 50px 10px;
  }
  .page-band__inner {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: center;
  }
  .page-band__title {
    font-size: 40px;
    font-weight: 500;
    line-height: 1.2;
    color: var(--white);
    text-align: center;
    margin: 0;
  }
  @media (max-width: 1024px) {
    .page-band__title {
      font-size: 32px;
    }
  }
  @media (max-width: 767px) {
    .page-band {
      padding: 36px 10px;
    }
    .page-band__title {
      font-size: 30px;
    }
  }

  .page-band :global(.page-band__crumbs) {
    margin: 0;
    font-size: 17px;
    font-weight: 500;
    color: var(--white);
  }
  .page-band :global(.page-band__crumbs ol) {
    justify-content: center;
  }
  .page-band :global(.page-band__crumbs a),
  .page-band :global(.page-band__crumbs [aria-current='page']) {
    color: var(--white);
  }
  .page-band :global(.page-band__crumbs a:hover) {
    text-decoration: underline;
  }
  .page-band :global(.page-band__crumbs li::after) {
    color: rgba(255, 255, 255, 0.75);
  }
  @media (max-width: 1024px) {
    .page-band :global(.page-band__crumbs) {
      font-size: 15px;
    }
  }
</style>
