---
import SpecTable from './SpecTable.astro';
import FaqAccordion from './FaqAccordion.astro';
import type { Product } from '../lib/catalog.ts';

/**
 * The WooCommerce tab strip, rebuilt with the WAI-ARIA tabs pattern.
 *
 * The live site also renders a "Reviews (0)" tab containing a WordPress
 * comment form. Every product has zero reviews, and a review form has no
 * backend once WordPress is gone, so the tab is dropped rather than shipped
 * broken. Specifications is the default panel, as Reviews was.
 */
export interface Props {
  product: Product;
}
const { product } = Astro.props;

const tabs = [
  { id: 'specifications', label: 'Specifications' },
  { id: 'faqs', label: 'Faqs' },
];
---

<div class="tabs" data-tabs>
  <div class="tabs__list" role="tablist" aria-label={`${product.name} details`}>
    {
      tabs.map((t, i) => (
        <button
          type="button"
          role="tab"
          id={`tab-${t.id}`}
          aria-controls={`panel-${t.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          class="tabs__tab"
        >
          {t.label}
        </button>
      ))
    }
  </div>

  <div
    class="tabs__panel"
    id="panel-specifications"
    role="tabpanel"
    aria-labelledby="tab-specifications"
    tabindex="0"
  >
    <h2 class="visually-hidden">Specifications</h2>
    <SpecTable
      headers={product.specHeaders}
      rows={product.specRows}
      caption={`${product.name} specifications`}
    />
  </div>

  <div
    class="tabs__panel"
    id="panel-faqs"
    role="tabpanel"
    aria-labelledby="tab-faqs"
    tabindex="0"
    hidden
  >
    <h2 class="visually-hidden">Frequently asked questions</h2>
    {/* 15 questions read as a wall of text when laid out flat, so they use the
        same accordion the homepage and category pages do. The text stays in the
        DOM, so the FAQPage schema still matches what the page contains. */}
    <FaqAccordion faqs={product.faqs} class="product-faqs" />
  </div>
</div>

<style>
  .tabs__list {
    display: flex;
    flex-wrap: wrap;
    gap: 2px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 26px;
  }
  .tabs__tab {
    font-family: var(--font);
    font-size: 16px;
    font-weight: 400;
    color: var(--black);
    background: #f1f1f1;
    border: 1px solid var(--border);
    border-bottom: 0;
    border-radius: 4px 4px 0 0;
    padding: 10px 18px;
    margin-bottom: -1px;
    cursor: pointer;
  }
  .tabs__tab[aria-selected='true'] {
    background: var(--white);
    border-bottom: 1px solid var(--white);
    font-weight: 500;
  }
  .tabs__tab:hover {
    color: var(--red);
  }
  .tabs__tab:focus-visible {
    outline: var(--focus);
    outline-offset: -3px;
  }
  .tabs__panel[hidden] {
    display: none;
  }
  .tabs__panel:focus-visible {
    outline: var(--focus);
    outline-offset: 4px;
  }

  .tabs :global(.product-faqs) {
    max-width: 900px;
  }
  @media (max-width: 767px) {
    .tabs__tab {
      font-size: 15px;
      padding: 9px 14px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = tabs.map((t) =>
      root.querySelector<HTMLElement>(`#${t.getAttribute('aria-controls')}`),
    );

    function select(index: number, focus = true) {
      tabs.forEach((t, i) => {
        const on = i === index;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        panels[i]?.toggleAttribute('hidden', !on);
      });
      if (focus) tabs[index]?.focus();
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i, false));
      tab.addEventListener('keydown', (e) => {
        const last = tabs.length - 1;
        let next: number | null = null;
        if (e.key === 'ArrowRight') next = i === last ? 0 : i + 1;
        else if (e.key === 'ArrowLeft') next = i === 0 ? last : i - 1;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = last;
        if (next !== null) {
          e.preventDefault();
          select(next);
        }
      });
    });
  });
</script>
